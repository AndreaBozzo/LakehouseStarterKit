# ============================================
# Lakehouse Starter Kit - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# --------------------------------------------
# MinIO Configuration
# --------------------------------------------
# MinIO is an S3-compatible object storage used as data lake
MINIO_USER=admin
MINIO_PASS=your_secure_password_here

# --------------------------------------------
# Superset Configuration
# --------------------------------------------
# Superset is the visualization and BI tool
SUPERSET_USER=admin
SUPERSET_PASS=your_secure_password_here
# Generate a secure secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SUPERSET_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY

# --------------------------------------------
# PostgreSQL Configuration
# --------------------------------------------
# PostgreSQL is used as:
# 1. Example source database (e-commerce data)
# 2. Metadata store for Prefect orchestration
# 3. Metadata store for Metabase visualization
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=ecommerce
# Connection from host machine (mapped to port 5433 to avoid conflicts)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# Note: Docker internal port is 5432, host port is 5433

# --------------------------------------------
# S3/MinIO Access Configuration
# --------------------------------------------
# Used by DuckDB and dlt to access MinIO as S3-compatible storage
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=your_secure_password_here
S3_ENDPOINT=http://minio:9000
# For local development outside Docker, use: http://localhost:9000

# --------------------------------------------
# dlt Configuration
# --------------------------------------------
# Data load tool configuration
DLT_PROJECT_DIR=.dlt
DLT_DATA_DIR=.dlt

# --------------------------------------------
# Prefect Configuration
# --------------------------------------------
# Prefect orchestration server (runs in Docker)
PREFECT_API_URL=http://localhost:4200/api

# --------------------------------------------
# Metabase Configuration
# --------------------------------------------
# Metabase visualization server (runs in Docker)
# Connect to DuckDB database at: /duckdb/lakehouse.duckdb (inside container)
MB_DB_TYPE=postgres
MB_DB_HOST=postgres
MB_DB_PORT=5432
MB_DB_DBNAME=metabase
MB_DB_USER=postgres
MB_DB_PASS=your_postgres_password

# --------------------------------------------
# Optional: GitHub API Token
# --------------------------------------------
# If you hit rate limits on GitHub API, create a personal access token
# GITHUB_TOKEN=your_github_personal_access_token_here
